---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE } from '../../data/site';

// Published posts only, newest first. Drafts never reach the listing,
// the sitemap, or the static path build.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  });

// BreadcrumbList helps Google and LLMs place these pages in the site tree.
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Writing',
      item: new URL('/blog/', SITE.url).href,
    },
  ],
};
---

<BaseLayout
  title="Writing"
  path="/blog/"
  description="Field notes on lead resale, call attestation, speed to contact and speed-to-lead, and auditing the people who handle your leads."
  jsonLd={[breadcrumb]}
>
  <PageHeader eyebrow="Writing" title="Field notes on lead integrity">
    How to tell whether your leads are worked, ignored, mishandled, or quietly
    resold, and the signals that prove it.
  </PageHeader>

  <section class="section">
    <div class="shell">
      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`} class="post-link">
                <time datetime={post.data.pubDate.toISOString()} class="post-date">
                  {fmt(post.data.pubDate)}
                </time>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-desc">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <span class="post-tags">{post.data.tags.join(' · ')}</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    max-width: 64ch;
  }
  .post-link {
    display: block;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    transition:
      border-color 0.16s ease,
      transform 0.16s ease;
  }
  .post-link:hover {
    border-color: var(--color-signal);
    transform: translateY(-2px);
  }
  .post-date {
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-bone-dim);
  }
  .post-title {
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    margin: 10px 0 8px;
    line-height: 1.25;
  }
  .post-desc {
    color: var(--color-bone-dim);
    line-height: 1.6;
    font-size: 0.98rem;
    margin: 0 0 12px;
  }
  .post-tags {
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-signal);
  }
</style>
