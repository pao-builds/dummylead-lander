---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CTA } from '../data/site';
---

<BaseLayout title="Not found" path="/404/" noindex={true}>
  <section class="nf section">
    <div class="shell nf-inner">
      <span class="eyebrow">Signal lost</span>
      <h1 class="nf-code">404</h1>
      <p class="nf-msg">
        This trail went cold. The page you’re looking for isn’t being monitored.
      </p>
      <div class="nf-actions">
        <a href="/" class="btn btn-primary">Back to base</a>
        <a href="/#how-it-works" class="btn btn-ghost">How it works</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-inner {
    text-align: center;
    max-width: 48ch;
    margin-inline: auto;
    padding-block: clamp(40px, 8vw, 90px);
  }
  .nf-code {
    font-size: clamp(5rem, 18vw, 11rem);
    line-height: 1;
    color: var(--color-signal);
    margin: 18px 0 0;
  }
  .nf-msg {
    margin: 18px auto 0;
    color: var(--color-bone-dim);
    line-height: 1.6;
    font-size: 1.05rem;
  }
  .nf-actions {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
</style>
