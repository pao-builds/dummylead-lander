---
import { CTA } from '../data/site';
import ContactFeed from './ContactFeed.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker" data-reveal>UNDERCOVERED LEADS</p>
      <h1 id="hero-title" data-reveal style="--d:.06s">One lead.<br /> <span>The whole story.</span></h1>
      <p class="hero-sub" data-reveal style="--d:.12s">See what happens with your lead.<br class="desktop-break" /> Who calls, who texts, and who sends emails.</p>
      <div class="hero-actions" data-reveal style="--d:.18s">
        <a href={CTA.primary.href} class="btn btn-primary">{CTA.primary.label} <span aria-hidden="true">↗</span></a>
        <a href="/#how-it-works" class="secondary-link">See how it works <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ContactFeed />
  </div>
</section>

<style>
  .hero { padding: clamp(42px, 6vw, 84px) 0 clamp(36px, 5vw, 72px); }
  /* Copy on the left, the live contact feed on the right. */
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: clamp(40px, 6vw, 88px); }
  .hero-kicker { color: var(--color-signal); font-size: 12px; font-weight: 650; letter-spacing: .18em; margin: 0 0 18px; }
  h1 { font-size: clamp(2.8rem, 5vw, 4rem); line-height: 1.04; letter-spacing: -.055em; margin: 0; font-weight: 700; }
  h1 span { color: var(--color-signal); white-space: nowrap; }
  .hero-sub { font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.65; color: var(--color-bone-dim); margin: 22px 0 0; max-width: 520px; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 28px; margin-top: 28px; }
  .hero-actions .btn { font-size: 15px; padding: 14px 24px; gap: 20px; }
  .secondary-link { font-size: 14px; font-weight: 600; display: inline-flex; gap: 12px; align-items: center; padding: 10px 0; }
  .secondary-link:hover { color: var(--color-signal); }
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .hero-copy { text-align: center; }
    .hero-sub { margin-inline: auto; }
    .hero-actions { justify-content: center; }
  }
  @media (max-width: 760px) {
    .hero { padding-top: 42px; }
    .desktop-break { display: none; }
  }
</style>
