---
import { PRICING } from '../data/content';
import { CTA } from '../data/site';
import SectionHeader from './SectionHeader.astro';

const ctaFor = (kind: 'start' | 'talk') =>
  kind === 'talk' ? CTA.demo : CTA.primary;
---

<section id="pricing" class="section">
  <div class="shell">
    <SectionHeader title="Pay per seed. Pay less as you scale.">
      {PRICING.note}
    </SectionHeader>

    <div class="tiers">
      {
        PRICING.tiers.map((t) => (
          <article class="tier">
            <header class="tier-head">
              <h3 class="tier-name">{t.name}</h3>
              <p class="tier-for">{t.forWho}</p>
            </header>

            <div class="tier-price">
              <span class="price">{t.price}</span>
              <span class="unit">{t.unit}</span>
            </div>
            <span class="tier-seeds">{t.seeds}</span>

            <a
              href={ctaFor(t.cta).href}
              class="btn btn-primary tier-cta"
            >
              {ctaFor(t.cta).label}
            </a>
          </article>
        ))
      }
    </div>

  </div>
</section>

<style>
  .tiers {
    margin-top: clamp(40px, 5vw, 60px);
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: stretch;
  }
  @media (min-width: 820px) {
    .tiers {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
  }

  .tier {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 3vw, 32px);
    box-shadow: var(--shadow-sm);
  }
  .tier-name {
    font-size: 1.3rem;
    margin: 0;
  }
  .tier-for {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 8px 0 0;
    min-height: 2.7em;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 22px;
  }
  .price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.4rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .unit {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .tier-seeds {
    display: inline-flex;
    align-self: flex-start;
    margin-top: 14px;
    font-family: var(--font-body);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-bone-dim);
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--color-line-strong);
    background: var(--color-surface-2);
  }

  .tier-cta {
    margin-top: 26px;
    justify-content: center;
    width: 100%;
  }

</style>
