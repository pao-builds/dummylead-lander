---
// Hero visual: what reaches your secret shopper lead. Contact attempts land
// one by one like live notifications (newest on top): the company that got
// the lead calls, texts and emails her.
//
// The markup IS the finished frame (every row visible), so no-JS and
// reduced-motion visitors see the whole story. The script replays it as a
// loop while it's on screen.
---

<div class="contact-feed" data-contact-feed>
  <p class="cf-sr">
    Illustrative example. Jane D., your secret shopper lead. Apex Solar calls 2 minutes after you plant her,
    texts at 4 minutes and emails a quote at 21 minutes.
  </p>

  <div class="cf-panel" aria-hidden="true">
    <div class="cf-lead">
      <span class="cf-lead-hat"><img src="/dummylead-hat.svg" alt="" width="48" height="26" /></span>
      <div>
        <strong>Jane D.</strong>
        <span class="cf-lead-role">Secret shopper lead</span>
      </div>
    </div>

    <ol class="cf-list">
      <li>
        <div class="cf-note">
          <span class="cf-icon"><svg viewBox="0 0 24 24"><path d="M3 6h18v12H3z" /><path d="m3 7 9 6 9-6" /></svg></span>
          <div class="cf-body">
            <strong>Apex Solar</strong>
            <p>Your solar quote is ready</p>
          </div>
          <time>21 min</time>
        </div>
      </li>
      <li>
        <div class="cf-note">
          <span class="cf-icon"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12" /></svg></span>
          <div class="cf-body">
            <strong>Apex Solar</strong>
            <div class="cf-text">
              <p class="cf-msg">“Hi Jane, about your quote…”</p>
              <span class="cf-typing"><i></i><i></i><i></i></span>
            </div>
          </div>
          <time>4 min</time>
        </div>
      </li>
      <li>
        <div class="cf-note">
          <span class="cf-icon cf-ring"><svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg></span>
          <div class="cf-body">
            <strong>Apex Solar</strong>
            <p>Incoming call, recorded</p>
          </div>
          <time>2 min</time>
        </div>
      </li>
    </ol>
  </div>
  <script is:inline>
    // Hide the rows before first paint so the finished frame doesn't flash
    // before GSAP takes over. Falls back to the static frame if the module
    // never boots.
    (function () {
      var root = document.currentScript.parentElement;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      root.classList.add('is-armed');
      setTimeout(function () { if (!root.hasAttribute('data-ready')) root.classList.remove('is-armed'); }, 4000);
    })();
  </script>
</div>

<style>
  .contact-feed { --cf-blue: var(--color-signal); position: relative; width: 100%; max-width: 460px; margin: 0 auto; }
  .cf-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .contact-feed.is-armed:not([data-ready]) .cf-note { opacity: 0; }

  /* The lead everything below is happening to. */
  .cf-lead { display: flex; align-items: center; gap: 16px; margin-bottom: 14px; padding: 16px 18px; border-radius: 18px; background: #fff; box-shadow: 0 0 0 1px var(--color-line), 0 18px 36px -24px hsl(193 100% 14% / .55); text-align: left; }
  .cf-lead-hat { display: grid; place-items: center; flex-shrink: 0; width: 60px; height: 60px; border-radius: 50%; background: var(--color-ink-2); }
  .cf-lead-hat img { width: 44px; height: 24px; }
  .cf-lead strong { display: block; font-family: var(--font-display); font-size: 22px; font-weight: 700; letter-spacing: -.03em; line-height: 1.15; color: var(--color-navy); }
  .cf-lead-role { display: block; margin-top: 2px; font-size: 14px; color: var(--color-signal); font-weight: 550; }

  .cf-list { position: relative; display: flex; flex-direction: column; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .cf-note { display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 14px; padding: 14px 16px; border-radius: 16px; background: #fff; box-shadow: 0 0 0 1px var(--color-line), 0 10px 24px -18px hsl(193 100% 14% / .5); text-align: left; will-change: transform, opacity; }
  .cf-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #e6f3f8; }
  .cf-icon svg { width: 18px; height: 18px; fill: none; stroke: var(--cf-blue); stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .cf-body { min-width: 0; }
  .cf-text { position: relative; }
  .cf-body strong { display: block; font-size: 14px; font-weight: 600; color: var(--color-navy); }
  .cf-body p { margin: 2px 0 0; font-size: 13px; color: var(--color-bone-dim); }
  .cf-note time { align-self: start; font-size: 12px; color: var(--color-muted); white-space: nowrap; }



  /* Typing indicator shown just before the text lands (hidden in the static frame). */
  .cf-typing { position: absolute; left: 0; top: 50%; margin-top: -3px; display: flex; gap: 4px; opacity: 0; }
  .cf-typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-faint); animation: cf-bounce 1s infinite; }
  .cf-typing i:nth-child(2) { animation-delay: .15s; }
  .cf-typing i:nth-child(3) { animation-delay: .3s; }
  @keyframes cf-bounce { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(-3px); } }

  @media (max-width: 480px) {
    .cf-note { gap: 12px; padding: 12px 14px; }
    .cf-icon { width: 36px; height: 36px; }
  }
</style>

<script>
  import gsap from 'gsap';

  function setup(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('.cf-list')!;
    // DOM order is newest-first, which is also the finished layout.
    const notes = [...list.querySelectorAll<HTMLElement>('.cf-note')];
    const n = notes.length;

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Rows never leave their final layout; they only move with transforms
    // (GPU work, no reflow per frame). Arrival m puts the newest row in the
    // top slot and slides every earlier row down one slot.
    const build = () => {
      gsap.set(notes, { clearProps: 'transform,opacity,visibility' });
      const tops = notes.map((el) => el.offsetTop);
      const tl = gsap.timeline({ paused: true, repeat: -1 });
      tl.set(notes, { autoAlpha: 0, y: 0, scale: 1 }, 0);

      for (let m = 1; m <= n; m++) {
        const d = n - m; // DOM index of the arriving row
        const at = 0.4 + (m - 1) * 1.3;
        const top = tops[0] - tops[d];
        tl.fromTo(
          notes[d],
          { autoAlpha: 0, y: top - 18, scale: 0.96 },
          { autoAlpha: 1, y: top, scale: 1, duration: 0.55, ease: 'power3.out', immediateRender: false },
          at,
        );
        for (let k = d + 1; k < n; k++) {
          tl.to(notes[k], { y: tops[k - d] - tops[k], duration: 0.55, ease: 'power3.out' }, at);
        }

        // Calls ring as they land.
        const ring = notes[d].querySelector('.cf-ring');
        if (ring) tl.to(ring, { keyframes: { rotate: [0, -16, 14, -12, 10, -6, 0] }, duration: 0.7, ease: 'none' }, at + 0.2);

        // Texts show the typing dots first.
        const typing = notes[d].querySelector('.cf-typing');
        const msg = notes[d].querySelector('.cf-msg');
        if (typing && msg) {
          tl.set(msg, { opacity: 0 }, 0)
            .set(typing, { opacity: 1 }, at)
            .set(typing, { opacity: 0 }, at + 0.8)
            .to(msg, { opacity: 1, duration: 0.25 }, at + 0.8);
        }
      }

      // Hold the full feed, then clear it for the next loop.
      tl.to(notes, { autoAlpha: 0, duration: 0.4 }, 0.4 + n * 1.3 + 2.6);
      return tl;
    };

    let tl = build();
    let visible = false;
    root.setAttribute('data-ready', '');

    const run = () => (visible ? tl.play() : tl.pause());
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      run();
    }).observe(list);

    // Width changes re-wrap the text: re-measure and restart the loop.
    let width = list.offsetWidth;
    new ResizeObserver(() => {
      if (list.offsetWidth === width) return;
      width = list.offsetWidth;
      tl.kill();
      tl = build();
      run();
    }).observe(list);
  }

  document.querySelectorAll<HTMLElement>('[data-contact-feed]').forEach(setup);
</script>
