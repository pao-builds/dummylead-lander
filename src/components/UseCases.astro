---
import { USE_CASES } from '../data/content';
import SectionHeader from './SectionHeader.astro';

const check =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

interface Props {
  showHeader?: boolean;
}
const { showHeader = true } = Astro.props;
---

<section id="use-cases" class="section">
  <div class="shell">
    {
      showHeader && (
        <SectionHeader title="One dummy lead, four kinds of proof">
          The same dummy lead tells a very different story depending on whose
          hands it ends up in. Here is what the proof looks like.
        </SectionHeader>
      )
    }

    <div class="cases" data-cases>
      {
        USE_CASES.map((u, i) => (
          <article id={u.slug} class={`exhibit tone-${u.tone}`} style={`--i:${i}`}>
            <div class="exhibit-stage">
              {u.slug === 'lead-buyers' && (
                <svg viewBox="0 0 320 200" data-anim="resale" aria-label="One exclusive lead reaching a second, unauthorized caller">
                  <path class="s-line" d="M52 100 146 74" data-authline />
                  <path class="s-line flag" d="M160 70 C214 80 222 150 256 150" data-leakpath />
                  <g>
                    <circle class="s-node" cx="40" cy="100" r="15" />
                    <text class="s-glyph" x="40" y="105">★</text>
                    <text class="s-cap" x="40" y="130">Your lead</text>
                  </g>
                  <g>
                    <circle class="s-node ok s-pop" cx="160" cy="70" r="18" data-pop="buyer" />
                    <text class="s-glyph" x="160" y="75">A</text>
                    <text class="s-cap" x="160" y="42">Acme Buyer</text>
                    <text class="s-badge ok s-pop" x="160" y="101" data-badge="auth">AUTHORIZED</text>
                  </g>
                  <g>
                    <circle class="s-node bad s-pop" cx="256" cy="150" r="18" data-pop="unknown" />
                    <text class="s-glyph bad" x="256" y="155">?</text>
                    <text class="s-cap" x="256" y="182">Unknown number</text>
                    <text class="s-badge bad s-pop" x="256" y="124" data-badge="resale">RESALE</text>
                  </g>
                  <circle class="s-dot" r="6" cx="40" cy="100" data-dot />
                  <circle class="s-dot flag" r="5" cx="256" cy="150" data-leak />
                </svg>
              )}

              {u.slug === 'partners' && (
                <svg viewBox="0 0 320 200" data-anim="sla" aria-label="A first response arriving hours past the promised time">
                  <circle class="s-track" cx="160" cy="100" r="58" />
                  <circle class="s-arc" cx="160" cy="100" r="58" data-arc transform="rotate(-90 160 100)" />
                  <line class="s-tick" x1="160" y1="36" x2="160" y2="48" transform="rotate(43 160 100)" />
                  <text class="s-cap dim" x="214" y="52">15m</text>
                  <text class="s-clock" x="160" y="100" data-clock>2h 14m</text>
                  <text class="s-cap" x="160" y="120">elapsed</text>
                  <text class="s-badge amber s-pop" x="160" y="184" data-badge="late">1 LATE ATTEMPT</text>
                </svg>
              )}

              {u.slug === 'employees' && (
                <svg viewBox="0 0 320 200" data-anim="worked" aria-label="A rep dialing a lead fast across six attempts">
                  <path class="s-line" d="M80 84 224 84" />
                  <g>
                    <circle class="s-node" cx="62" cy="84" r="16" />
                    <text class="s-glyph" x="62" y="89">R</text>
                    <text class="s-cap" x="62" y="114">Your rep</text>
                  </g>
                  <g>
                    <circle class="s-node ok s-pop" cx="242" cy="84" r="19" data-pop="lead" />
                    <text class="s-glyph ok" x="242" y="90" data-leadglyph>✓</text>
                    <text class="s-cap" x="242" y="116">Lead</text>
                  </g>
                  <text class="s-badge ok s-pop" x="242" y="56" data-badge="worked">WORKED</text>
                  <text class="s-cap" x="160" y="150">6 of 6 attempts</text>
                  <g data-adots>
                    <circle class="s-adot" cx="92" cy="166" r="6" />
                    <circle class="s-adot" cx="119" cy="166" r="6" />
                    <circle class="s-adot" cx="146" cy="166" r="6" />
                    <circle class="s-adot" cx="173" cy="166" r="6" />
                    <circle class="s-adot" cx="200" cy="166" r="6" />
                    <circle class="s-adot" cx="227" cy="166" r="6" />
                  </g>
                  <circle class="s-dot" r="6" cx="62" cy="84" data-dot />
                </svg>
              )}

              {u.slug === 'compliance' && (
                <svg viewBox="0 0 320 200" data-anim="verified" aria-label="A call passing a carrier check and landing as a branded, verified number">
                  <text class="s-badge trust s-pop" x="160" y="38" data-badge="branded">BRANDED CALLER ID</text>
                  <rect class="s-card" x="72" y="62" width="176" height="46" rx="11" data-card />
                  <text class="s-num" x="160" y="90">+1 (628) 555-0114</text>
                  <rect class="s-scan" x="72" y="62" width="16" height="46" rx="3" data-scan />
                  <g class="s-pop" data-shield>
                    <circle class="s-stamp" cx="246" cy="64" r="14" />
                    <path class="s-check" d="M240 64 l4 4 l8 -9" />
                  </g>
                  <g>
                    <rect class="s-seg" x="118" y="150" width="28" height="22" rx="6" data-seg="C" />
                    <text class="s-seglbl dim" x="132" y="166" data-seglbl="C">C</text>
                    <rect class="s-seg" x="150" y="150" width="28" height="22" rx="6" data-seg="B" />
                    <text class="s-seglbl dim" x="164" y="166" data-seglbl="B">B</text>
                    <rect class="s-seg on" x="182" y="150" width="28" height="22" rx="6" data-seg="A" />
                    <text class="s-seglbl" x="196" y="166" data-seglbl="A">A</text>
                  </g>
                  <text class="s-badge trust s-pop" x="160" y="192" data-badge="grade">GRADE A · VERIFIED</text>
                </svg>
              )}
            </div>

            <div class="exhibit-meta">
              <div class="case-content">
                <span class="case-aud">{u.audience}</span>
                <h3 class="case-title">{u.title}</h3>
                <p class="case-prob">{u.problem}</p>
                <ul class="case-points">
                  {u.points.map((p) => (
                    <li>
                      <span class="pt-check" aria-hidden="true" set:html={check} />
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tone-signal {
    --tone: var(--color-signal);
    --tone-ink: var(--color-signal-deep);
  }
  .tone-amber {
    --tone: var(--color-amber);
    --tone-ink: var(--color-amber);
  }
  .tone-flag {
    --tone: var(--color-flag);
    --tone-ink: var(--color-flag);
  }
  .tone-trust {
    --tone: var(--color-trust);
    --tone-ink: var(--color-trust);
  }

  /* ================= layout: free-floating exhibits ================= */
  .cases {
    margin-top: clamp(36px, 5vw, 56px);
    display: flex;
    flex-direction: column;
  }
  .exhibit {
    --tone: var(--color-signal);
    --tone-ink: var(--color-signal-deep);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(18px, 4vw, 36px);
    align-items: center;
    max-width: 1060px;
    width: 100%;
    margin-inline: auto;
    padding-block: clamp(34px, 6vw, 60px);
  }
  .exhibit + .exhibit {
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 820px) {
    .exhibit {
      grid-template-columns: 1fr 1fr;
      gap: clamp(40px, 6vw, 80px);
    }
    .exhibit:nth-of-type(even) .exhibit-stage {
      order: 2;
    }
  }

  .exhibit-stage {
    display: grid;
    place-items: center;
    min-height: 220px;
  }
  .exhibit-stage svg {
    width: 100%;
    max-width: 360px;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* ================= case content ================= */
  .case-aud {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tone-ink);
  }
  .case-title {
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    margin: 12px 0 14px;
  }
  .case-prob {
    color: var(--color-muted);
    line-height: 1.6;
    font-size: 0.98rem;
    margin: 0 0 18px;
    max-width: 48ch;
  }
  .case-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .case-points li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    color: var(--color-bone);
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .pt-check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    color: var(--tone-ink);
    background: color-mix(in oklab, var(--tone) 13%, transparent);
  }
  .pt-check :global(svg) {
    width: 11px;
    height: 11px;
  }

  /* ================= SVG scene primitives ================= */
  .s-line {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 2;
    stroke-linecap: round;
  }
  .s-line.dash {
    stroke-dasharray: 4 5;
  }
  .s-line.flag {
    stroke: var(--color-flag);
  }
  .s-node {
    fill: var(--color-surface);
    stroke: var(--color-line-strong);
    stroke-width: 2;
  }
  .s-node.ok {
    stroke: var(--color-signal);
  }
  .s-node.bad {
    stroke: var(--color-flag);
  }
  .s-glyph {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    fill: var(--color-bone);
    text-anchor: middle;
  }
  .s-glyph.bad {
    fill: var(--color-flag);
  }
  .s-glyph.ok {
    fill: var(--color-signal-deep);
  }
  .s-glyph.trust {
    fill: #fff;
  }
  .s-cap {
    font-family: var(--font-body);
    font-size: 10px;
    letter-spacing: 0.04em;
    fill: var(--color-muted);
    text-anchor: middle;
  }
  .s-cap.dim {
    fill: var(--color-faint);
  }
  .s-badge {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.12em;
    text-anchor: middle;
  }
  .s-badge.ok {
    fill: var(--color-signal-deep);
  }
  .s-badge.bad {
    fill: var(--color-flag);
  }
  .s-badge.amber {
    fill: var(--color-amber);
  }
  .s-badge.trust {
    fill: var(--color-trust);
  }
  .s-dot {
    fill: var(--color-signal);
  }
  .s-dot.flag {
    fill: var(--color-flag);
  }
  .s-dot.amber {
    fill: var(--color-amber);
  }
  .s-dot.trust {
    fill: var(--color-trust);
  }
  .s-adot {
    fill: var(--color-signal);
  }
  /* stopwatch */
  .s-track {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 6;
  }
  .s-arc {
    fill: none;
    stroke: var(--color-amber);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 365;
  }
  .s-tick {
    stroke: var(--color-bone);
    stroke-width: 2.5;
  }
  .s-clock {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 19px;
    fill: var(--color-bone);
    text-anchor: middle;
  }
  /* verified card / scan / segments / stamp */
  .s-card {
    fill: var(--color-surface-2);
    stroke: var(--color-line-strong);
    stroke-width: 1.5;
  }
  .s-num {
    font-family: var(--font-body);
    font-size: 12px;
    fill: var(--color-bone);
    text-anchor: middle;
  }
  .s-scan {
    fill: color-mix(in oklab, var(--color-trust) 55%, transparent);
    opacity: 0;
  }
  .s-seg {
    fill: var(--color-surface-2);
    stroke: var(--color-line);
    stroke-width: 1.5;
    transition:
      fill 0.25s ease,
      stroke 0.25s ease;
  }
  .s-seg.on {
    fill: var(--color-trust);
    stroke: var(--color-trust);
  }
  .s-seglbl {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    fill: #fff;
    text-anchor: middle;
    transition: fill 0.25s ease;
  }
  .s-seglbl.dim {
    fill: var(--color-muted);
  }
  .s-stamp {
    fill: var(--color-trust);
  }
  .s-check {
    fill: none;
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* elements the timeline scales/rotates need their own transform box */
  .s-pop,
  .s-adot,
  .s-dot {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* armed (hidden) states the intro animates from */
  .cases.is-anim .exhibit-meta,
  .cases.is-anim .exhibit-stage {
    opacity: 0;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { MotionPathPlugin } from 'gsap/MotionPathPlugin';

  /**
   * Each case is a free-floating exhibit that acts out its own story with its
   * own motion: the resale lead clones and a rose dot rides a MotionPath curve
   * to an unknown caller; the SLA stopwatch arc sweeps hours past its promise;
   * the worked lead takes a fast burst of dials; the verified call gets scanned
   * and stamped Grade A. An intro plays once on enter; the scene loops only
   * while on screen. Reduced-motion / no-JS shows the finished diagrams static.
   */
  const root = document.querySelector<HTMLElement>('#use-cases [data-cases]');
  if (root && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);
    root.classList.add('is-anim');

    const HEX = { amber: '#d97706', flag: '#e11d48' };

    // One-time intro for an exhibit: fade the animation and copy in together.
    const intro = (ex: HTMLElement) => {
      const stage = ex.querySelector('.exhibit-stage');
      const meta = ex.querySelector('.exhibit-meta');
      const tl = gsap.timeline({ paused: true });
      tl.fromTo(stage, { opacity: 0, scale: 0.92 }, { opacity: 1, scale: 1, duration: 0.6, ease: 'power3.out' }, 0);
      tl.fromTo(meta, { opacity: 0, y: 18 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 0.05);
      return tl;
    };

    // Looping scene, one distinct motion per case.
    const buildScene = (ex: HTMLElement) => {
      const svg = ex.querySelector<SVGElement>('[data-anim]');
      if (!svg) return null;
      const q = (s: string) => svg.querySelector(s);
      const tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.8 });

      if (svg.dataset.anim === 'resale') {
        const dot = q('[data-dot]')!;
        const leak = q('[data-leak]')!;
        const auth = q('[data-badge="auth"]')!;
        const resale = q('[data-badge="resale"]')!;
        const authLine = svg.querySelector<SVGPathElement>('[data-authline]')!;
        const leakPath = svg.querySelector<SVGPathElement>('[data-leakpath]')!;
        const authLen = authLine.getTotalLength();
        const leakLen = leakPath.getTotalLength();
        tl.set(dot, { attr: { cx: 40, cy: 100 }, opacity: 1 })
          .set(leak, { attr: { cx: 0, cy: 0 }, x: 0, y: 0, scale: 0, opacity: 0 })
          .set([auth, resale], { opacity: 0, scale: 0.5 })
          .set(authLine, { strokeDasharray: authLen, strokeDashoffset: authLen, opacity: 1 })
          .set(leakPath, { strokeDasharray: leakLen, strokeDashoffset: leakLen, opacity: 1 })
          // the lead travels to the authorized buyer, drawing the line behind it
          .to(dot, { attr: { cx: 160, cy: 70 }, duration: 0.8, ease: 'power2.inOut' })
          .to(authLine, { strokeDashoffset: 0, duration: 0.8, ease: 'power2.inOut' }, '<')
          .to(auth, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' })
          // a copy pinches off and leaks down the curve, drawing its trail
          .to(leak, { motionPath: { path: leakPath, align: leakPath, alignOrigin: [0.5, 0.5] }, duration: 0.95, ease: 'power1.inOut' }, '+=0.3')
          .set(leak, { opacity: 1 }, '<')
          .to(leak, { scale: 1, duration: 0.3, ease: 'power2.out' }, '<')
          .to(leakPath, { strokeDashoffset: 0, duration: 0.95, ease: 'power1.inOut' }, '<')
          .to(resale, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' })
          .to({}, { duration: 1.5 })
          .to([dot, leak, auth, resale, authLine, leakPath], { opacity: 0, duration: 0.4 });
      } else if (svg.dataset.anim === 'sla') {
        const arc = q('[data-arc]')!;
        const clock = q('[data-clock]')!;
        const late = q('[data-badge="late"]')!;
        const C = 365;
        const fmt = (m: number) =>
          m < 60 ? `${m}m` : `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, '0')}m`;
        tl.set(arc, { strokeDashoffset: C, stroke: HEX.amber })
          .set(late, { opacity: 0, scale: 0.5 })
          .call(() => {
            clock.textContent = '0m';
          })
          .to(arc, {
            strokeDashoffset: C * 0.07,
            duration: 2.6,
            ease: 'none',
            onUpdate: () => {
              const off = Number(gsap.getProperty(arc, 'strokeDashoffset'));
              clock.textContent = fmt(Math.round((1 - off / C) * 134));
            },
          })
          .to(arc, { stroke: HEX.flag, duration: 1.7, ease: 'none' }, '<+=0.6')
          .call(() => {
            clock.textContent = '2h 14m';
          })
          .to(late, { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(2)' })
          .to({}, { duration: 1.4 })
          .to(late, { opacity: 0, duration: 0.4 });
      } else if (svg.dataset.anim === 'worked') {
        const dot = q('[data-dot]')!;
        const leadGlyph = q('[data-leadglyph]')!;
        const worked = q('[data-badge="worked"]')!;
        const adots = gsap.utils.toArray<Element>('.s-adot', svg);
        tl.set(dot, { attr: { cx: 62, cy: 84 }, opacity: 1 })
          .set(adots, { opacity: 0.25 })
          .set(leadGlyph, { opacity: 0, scale: 0.6 })
          .set(worked, { opacity: 0, scale: 0.6 });
        // the rep dials the lead six times, fast
        for (let i = 0; i < 6; i++) {
          tl.to(dot, { attr: { cx: 242 }, duration: 0.16, ease: 'power1.in' })
            .to(adots[i], { opacity: 1, duration: 0.24, ease: 'power2.out' }, '>-0.03')
            .to(dot, { attr: { cx: 62 }, duration: 0.12, ease: 'power1.out' });
        }
        tl.to(dot, { opacity: 0, duration: 0.2 })
          .to(leadGlyph, { opacity: 1, scale: 1, duration: 0.35, ease: 'power2.out' }, '-=0.05')
          .to(worked, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' }, '-=0.15')
          .to({}, { duration: 1.3 })
          .to(worked, { opacity: 0, duration: 0.4 })
          .to(adots, { opacity: 0.25, duration: 0.3 }, '<');
      } else if (svg.dataset.anim === 'verified') {
        const scan = q('[data-scan]')!;
        const shield = q('[data-shield]')!;
        const card = q('[data-card]')!;
        const grade = q('[data-badge="grade"]')!;
        const branded = q('[data-badge="branded"]')!;
        const NEUTRAL = '#c2cde0';
        const TRUST = '#8b5cf6';
        const setSeg = (l: string, on: boolean) => {
          q(`[data-seg="${l}"]`)!.classList.toggle('on', on);
          q(`[data-seglbl="${l}"]`)!.classList.toggle('dim', !on);
        };
        tl.set(scan, { attr: { x: 72 }, opacity: 0 })
          .set([grade, branded], { opacity: 0, scale: 0.5 })
          .set(shield, { opacity: 0, scale: 0.4, rotate: -12 })
          .set(card, { stroke: NEUTRAL })
          .call(() => {
            setSeg('A', false);
            setSeg('B', false);
            setSeg('C', false);
          })
          // scan sweeps across the number
          .to(scan, { opacity: 1, duration: 0.15 })
          .to(scan, { attr: { x: 232 }, duration: 0.95, ease: 'power1.inOut' })
          .to(scan, { opacity: 0, duration: 0.2 })
          // attestation climbs C -> B -> A
          .call(() => setSeg('C', true))
          .call(() => { setSeg('C', false); setSeg('B', true); }, [], '+=0.22')
          .call(() => { setSeg('B', false); setSeg('A', true); }, [], '+=0.22')
          // card verifies + check stamps at the corner
          .to(card, { stroke: TRUST, duration: 0.3 }, '<')
          .to(shield, { opacity: 1, scale: 1, rotate: 0, duration: 0.45, ease: 'back.out(2.4)' }, '<')
          .to(grade, { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(2)' }, '-=0.12')
          .to(branded, { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(2)' }, '-=0.16')
          .to({}, { duration: 1.6 })
          .to([scan, shield, grade, branded], { opacity: 0, duration: 0.4 })
          .to(card, { stroke: NEUTRAL, duration: 0.3 }, '<');
      }
      return tl;
    };

    const exhibits = gsap.utils.toArray<HTMLElement>('.exhibit', root);
    exhibits.forEach((ex) => {
      const introTL = intro(ex);
      const sceneTL = buildScene(ex);
      let introduced = false;
      ScrollTrigger.create({
        trigger: ex,
        start: 'top 82%',
        end: 'bottom 18%',
        onToggle: (self) => {
          if (self.isActive) {
            if (!introduced) {
              introTL.play();
              introduced = true;
            }
            sceneTL?.play();
          } else {
            sceneTL?.pause();
          }
        },
      });
    });
  }
</script>
