---
import { USE_CASES } from '../data/content';
import SectionHeader from './SectionHeader.astro';
import CallerReputation from './CallerReputation.astro';
import FlankExhibit from './FlankExhibit.astro';

// Timeline glyphs (stroke uses currentColor so each dot tints its icon).
const icons = {
  call: '<svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>',
  text: '<svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12" /></svg>',
  voicemail: '<svg viewBox="0 0 24 24"><circle cx="6.5" cy="12" r="3.5" /><circle cx="17.5" cy="12" r="3.5" /><path d="M6.5 15.5h11" /></svg>',
  alert: '<svg viewBox="0 0 24 24"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>',
};

// Illustrative activity log for one dummy lead. Each row shows what DummyLead
// captures for that contact; the last row is someone the lead was never sent to.
type Tag = { k?: string; v: string; flag?: boolean };
const LOG: { kind: keyof typeof icons; title: string; from: string; at: string; quote?: string; tags: Tag[]; flag?: boolean }[] = [
  {
    kind: 'call',
    title: 'Call',
    from: 'Apex Solar',
    at: '47 sec',
    tags: [{ k: 'Caller ID', v: 'APEX SOLAR' }, { k: 'Carrier', v: 'Verizon' }, { v: 'Recorded 3:12' }],
  },
  {
    kind: 'text',
    title: 'Text',
    from: 'Apex Solar',
    at: '4 min',
    quote: '“Hi Jane, about your quote…”',
    tags: [],
  },
  {
    kind: 'voicemail',
    title: 'Voicemail',
    from: 'Apex Solar',
    at: '2 hrs',
    tags: [{ v: '0:38 saved' }, { v: 'Transcribed' }],
  },
  {
    kind: 'alert',
    title: 'Call',
    from: '(415) 555-0199',
    at: 'Next day',
    flag: true,
    tags: [{ k: 'Caller ID', v: 'None shown' }, { k: 'Carrier', v: 'Bandwidth' }, { v: 'Not someone you sent it to', flag: true }],
  },
];

interface Props {
  showHeader?: boolean;
}
const { showHeader = true } = Astro.props;

// Lead activity exhibit first, then caller reputation (CallerReputation.astro).
const lead = USE_CASES.find((u) => u.slug === 'lead-buyers')!;
---

<section id="use-cases" class="section">
  <div class="shell">
    {
      showHeader && (
        <SectionHeader title="Watch what happens to your leads">
          Whether you sell leads, buy them, or pass them to a sales team, a
          dummy lead shows you what actually happens next.
        </SectionHeader>
      )
    }

    <div class="cases" data-cases>
      <FlankExhibit
        id={lead.slug}
        audience={lead.audience}
        title={lead.title}
        problem={lead.problem}
        points={lead.points}
        tone="signal"
      >
          <div class="log" data-log>
            <p class="log-sr">
              Illustrative example. Jane D., a dummy lead, gets a recorded call from Apex Solar after
              47 seconds, a text at 4 minutes, a voicemail at 2 hours, and the next day a call from
              an unknown number she was never sent to.
            </p>
            <div class="log-head" aria-hidden="true">
              <span class="log-hat"><img src="/dummylead-hat.svg" alt="" width="40" height="22" /></span>
              <div>
                <strong>Jane D.</strong>
                <span>Dummy lead activity</span>
              </div>
            </div>

            <ol class="log-list" aria-hidden="true">
              {
                LOG.map((row, i) => (
                  <li class:list={['log-row', { flag: row.flag }]}>
                    {i < LOG.length - 1 && <span class="log-conn" />}
                    <span class="log-dot" set:html={icons[row.kind]} />
                    <div class="log-body">
                      <p class="log-title">
                        <span>
                          <strong>{row.title}</strong> from {row.from}
                        </span>
                        <time>{row.at}</time>
                      </p>
                      {row.quote && <p class="log-quote">{row.quote}</p>}
                      {row.tags.length > 0 && (
                        <div class="log-tags">
                          {row.tags.map((t) => (
                            <span class:list={['log-tag', { flag: t.flag }]}>
                              {t.k && <b>{t.k}</b>}
                              {t.v}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
      </FlankExhibit>
    </div>

    <CallerReputation />
  </div>
</section>

<style>
  .cases {
    margin-top: clamp(24px, 3vw, 36px);
  }

  /* ================= activity timeline (free-floating, no card) ================= */
  .log {
    position: relative;
    /* fixed (not min()) so the auto-width center column sizes to it */
    width: 360px;
    max-width: 100%;
  }
  .log-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .log-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
  }
  .log-hat {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-ink-2);
  }
  .log-hat img {
    width: 30px;
    height: 17px;
  }
  .log-head strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-navy);
    line-height: 1.2;
  }
  .log-head span {
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .log-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .log-row {
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 12px;
    align-items: start;
  }
  /* connector from this dot down to the next one */
  .log-conn {
    position: absolute;
    left: 17px;
    top: 38px;
    bottom: -14px;
    width: 2px;
    border-radius: 2px;
    background: var(--color-line-strong);
    transform-origin: top;
  }
  .log-dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--color-signal);
    background: var(--color-surface);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-signal) 28%, var(--color-line));
  }
  .log-dot :global(svg) {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .log-row.flag .log-dot {
    color: var(--color-flag);
    background: color-mix(in oklab, var(--color-flag) 10%, var(--color-surface));
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-flag) 35%, var(--color-line));
  }
  .log-body {
    min-width: 0;
    padding-top: 2px;
  }
  .log-title {
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 0.86rem;
    color: var(--color-bone-dim);
    line-height: 1.35;
  }
  .log-title strong {
    color: var(--color-navy);
    font-weight: 600;
  }
  .log-title time {
    flex: none;
    font-size: 0.74rem;
    color: var(--color-muted);
  }
  .log-quote {
    margin: 4px 0 0;
    font-size: 0.82rem;
    color: var(--color-bone-dim);
  }
  .log-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 7px;
  }
  .log-tag {
    display: inline-flex;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-bone-dim);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .log-tag b {
    font-weight: 500;
    color: var(--color-muted);
  }
  .log-tag.flag {
    font-weight: 600;
    color: var(--color-flag);
    background: color-mix(in oklab, var(--color-flag) 9%, var(--color-surface));
    border-color: color-mix(in oklab, var(--color-flag) 30%, var(--color-line));
  }

</style>

<script>
  import gsap from 'gsap';
  import { flank } from '../scripts/flank';

  /**
   * The activity log fills in like a live lead: each contact lands in turn,
   * its connector draws down to the next, and its detail tags (caller ID,
   * carrier, recording) pop in. As each row lands, the side points it
   * illustrates light up (FlankExhibit). The points slide in once on enter;
   * the log loops only while on screen. Reduced-motion / no-JS shows the
   * finished log static with every point lit.
   */
  const ex = document.querySelector<HTMLElement>('#use-cases #lead-buyers');
  const log = ex?.querySelector<HTMLElement>('[data-log]');

  // Which of lead.points (content.ts) each log row illustrates, in LOG order,
  // then the points lit while the finished log holds.
  const ROW_LIT = [
    [0, 1], // call: timestamped, caller ID + carrier
    [0, 2], // text at 4 min: how fast
    [0, 2], // voicemail at 2 hrs: how often
    [1, 3], // unknown number: caller ID, someone you didn't send it to
  ];
  const END_LIT = [4]; // the whole log is the record

  if (ex && log) {
    const pts = flank(ex);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      pts.all();
    } else {
      const rows = gsap.utils.toArray<HTMLElement>('.log-row', log);
      const tl = gsap.timeline({ paused: true, repeat: -1, repeatDelay: 0.6 });

      tl.set(rows, { autoAlpha: 0, y: 10 });
      tl.set(log.querySelectorAll('.log-conn'), { scaleY: 0 });
      tl.set(log.querySelectorAll('.log-tag'), { autoAlpha: 0 });

      rows.forEach((row, i) => {
        const at = 0.3 + i * 1.4;
        tl.call(pts.light, [ROW_LIT[i] ?? []], at);
        tl.to(row, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, at);
        tl.fromTo(
          row.querySelector('.log-dot'),
          { scale: 0.6 },
          { scale: 1, duration: 0.45, ease: 'back.out(2.4)' },
          at
        );
        const tags = row.querySelectorAll('.log-tag');
        if (tags.length) {
          tl.fromTo(
            tags,
            { autoAlpha: 0, scale: 0.85 },
            { autoAlpha: 1, scale: 1, duration: 0.3, stagger: 0.09, ease: 'back.out(2)' },
            at + 0.3
          );
        }
        const conn = row.querySelector('.log-conn');
        if (conn) tl.to(conn, { scaleY: 1, duration: 0.5, ease: 'power1.inOut' }, at + 0.55);
      });

      // Hold the finished log, then clear it for the next loop.
      tl.call(pts.light, [END_LIT], '+=0.6');
      tl.to({}, { duration: 2.6 });
      tl.to(rows, { autoAlpha: 0, duration: 0.4 });

      let introduced = false;
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return tl.pause();
          if (introduced) return tl.play();
          introduced = true;
          pts.enter(() => tl.play());
        },
        { threshold: 0.3 }
      );
      pts.arm();
      io.observe(log);
    }
  }
</script>
