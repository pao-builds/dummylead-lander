---
/** Shared hat symbol; white variant for dark surfaces. */
interface Props {
  variant?: 'color' | 'white';
  size?: number;
  class?: string;
}
const { variant = 'color', size = 28, class: cls } = Astro.props;
const src = '/dummylead-hat.svg';
---

<img
  src={src}
  alt=""
  width={size}
  height={size}
  class:list={['logo', { 'logo-white': variant === 'white' }, cls]}
  aria-hidden="true"
  loading="eager"
  decoding="async"
/>

<style>
  .logo {
    display: block;
    object-fit: contain;
  }
  .logo-white { filter: brightness(0) invert(1); }
</style>
