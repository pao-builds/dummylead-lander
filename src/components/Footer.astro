---
import { SITE, NAV, CTA, LEGAL_NAV } from '../data/site';
import Brand from './Brand.astro';
const year = 2026;
---

<footer class="site-footer on-navy">
  <div class="shell">
    <div class="foot-main">
      <div class="foot-brand">
        <Brand inverse />
        <p class="foot-tag">{SITE.tagline}.</p>
        <a href={CTA.primary.href} class="btn btn-primary foot-cta">
          {CTA.primary.label}
        </a>
      </div>

      <nav class="foot-cols" aria-label="Footer">
        <div class="foot-col">
          <h4>Product</h4>
          {NAV.map((i) => <a href={i.href}>{i.label}</a>)}
        </div>
        <div class="foot-col">
          <h4>Detect</h4>
          <a href="/#lead-buyers">Lead resale</a>
          <a href="/#compliance">Spam & attestation</a>
        </div>
        <div class="foot-col">
          <h4>Company</h4>
          <a href="/blog/">Blog</a>
          <a href="/contact/">Contact</a>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={CTA.secondary.href}>Sign in</a>
        </div>
      </nav>
    </div>

    <div class="foot-bottom">
      <span class="foot-fine">© {year} {SITE.name}. All rights reserved.</span>
      <nav class="foot-legal" aria-label="Legal">
        {LEGAL_NAV.map((i) => <a href={i.href}>{i.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
  /* Footer text tones are tints of the brand sky hue (198), so they read as
     part of the navy rather than as neutral greys laid on top of it. */
  .site-footer {
    --foot-text: hsl(198 35% 84%);
    --foot-dim: hsl(198 22% 66%);
    --foot-label: hsl(198 45% 62%);
    margin-top: clamp(48px, 6vw, 80px);
    padding: 0 0 32px;
    background: var(--color-navy);
    color: var(--foot-text);
  }

  /* ---- main ---- */
  .foot-main {
    display: grid;
    gap: 44px;
    grid-template-columns: 1fr;
    padding-top: clamp(48px, 6vw, 72px);
    padding-bottom: clamp(40px, 5vw, 56px);
  }
  .foot-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .foot-tag {
    color: var(--foot-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 18px 0 22px;
    max-width: 30ch;
  }
  /* The site's primary button is navy, which vanishes on the navy footer.
     Invert it here: white fill, navy label. */
  .foot-cta {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--color-navy);
    box-shadow: 0 10px 24px -12px rgba(0, 0, 0, 0.5);
  }
  .foot-cta:hover {
    background: var(--color-ink-2);
    border-color: var(--color-ink-2);
    box-shadow: 0 14px 28px -12px rgba(0, 0, 0, 0.55);
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .foot-col h4 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--foot-label);
    margin: 0 0 6px;
  }
  .foot-col a {
    color: var(--foot-text);
    font-size: 0.9rem;
    transition: color 0.16s ease;
  }
  .foot-col a:hover {
    color: #ffffff;
  }

  /* ---- bottom bar: copyright + legal on one line ---- */
  .foot-bottom {
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    justify-content: space-between;
    align-items: center;
  }
  .foot-fine {
    font-size: 0.8rem;
    color: var(--foot-dim);
  }
  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
  }
  .foot-legal a {
    font-size: 0.8rem;
    color: var(--foot-dim);
    transition: color 0.16s ease;
  }
  .foot-legal a:hover {
    color: #ffffff;
  }

  @media (min-width: 820px) {
    .foot-main {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
    .foot-cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
