---
import { USE_CASES } from '../data/content';
import FlankExhibit from './FlankExhibit.astro';

/**
 * Caller-reputation exhibit: a phone playing three real-looking incoming
 * calls, centered between the check points (FlankExhibit.astro). Each point
 * lights up during the call it describes. Rendered inside the Use cases section
 * (UseCases.astro) rather than as a section of its own.
 */
const rep = USE_CASES.find((u) => u.slug === 'compliance')!;

// Status-bar glyphs.
const bars =
  '<svg viewBox="0 0 17 11" fill="currentColor"><rect x="0" y="7" width="3" height="4" rx="1"/><rect x="4.5" y="5" width="3" height="6" rx="1"/><rect x="9" y="2.5" width="3" height="8.5" rx="1"/><rect x="13.5" y="0" width="3" height="11" rx="1"/></svg>';
const wifi =
  '<svg viewBox="0 0 15 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 3.6a9 9 0 0 1 13 0"/><path d="M3.6 6.2a5.4 5.4 0 0 1 7.8 0"/><circle cx="7.5" cy="9" r="1" fill="currentColor" stroke="none"/></svg>';
const batt =
  '<svg viewBox="0 0 25 12" fill="none" stroke="currentColor"><rect x="0.5" y="0.5" width="21" height="11" rx="3.2" opacity="0.4"/><rect x="2" y="2" width="15" height="8" rx="1.8" fill="currentColor" stroke="none"/><path d="M23 4.2v3.6c.8-.3 1.3-1 1.3-1.8s-.5-1.5-1.3-1.8z" fill="currentColor" stroke="none" opacity="0.4"/></svg>';

// Call-screen glyphs (iOS-style: filled, no strokes on the big buttons).
const ico = {
  handset:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.4 11.4 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2z"/></svg>',
  alarm:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="13" r="7"/><path d="M12 9.5V13l2.2 1.6M4.5 5 6.8 3M19.5 5 17.2 3"/></svg>',
  message:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.5c-5 0-9 3.3-9 7.4 0 2.4 1.4 4.5 3.5 5.9L6 20.5l3.9-2.2c.7.1 1.4.2 2.1.2 5 0 9-3.3 9-7.4S17 3.5 12 3.5z"/></svg>',
  speaker:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 9.2v5.6h3.6L12.5 19V5L7.6 9.2z" fill="currentColor" stroke="none"/><path d="M15.8 9a4.2 4.2 0 0 1 0 6M18.4 6.4a8 8 0 0 1 0 11.2"/></svg>',
  video:
    '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="2.5" y="6.5" width="13" height="11" rx="2.6"/><path d="m16.5 10.6 5-3.1v9l-5-3.1z"/></svg>',
  mute: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor" stroke="none"/><path d="M5.8 11a6.2 6.2 0 0 0 12.4 0M12 17.4V21"/></svg>',
  more: '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="5.5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="18.5" cy="12" r="2"/></svg>',
  keypad:
    '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="6.5" cy="4.5" r="1.7"/><circle cx="12" cy="4.5" r="1.7"/><circle cx="17.5" cy="4.5" r="1.7"/><circle cx="6.5" cy="10" r="1.7"/><circle cx="12" cy="10" r="1.7"/><circle cx="17.5" cy="10" r="1.7"/><circle cx="6.5" cy="15.5" r="1.7"/><circle cx="12" cy="15.5" r="1.7"/><circle cx="17.5" cy="15.5" r="1.7"/><circle cx="12" cy="21" r="1.7"/></svg>',
};
---

<FlankExhibit
  id="compliance"
  audience={rep.audience}
  title={rep.title}
  problem={rep.problem}
  points={rep.points}
  tone="trust"
  divider
>
    <div class="rep-stage" data-call>
      <!-- The device. Everything inside is decorative; the check list
           carries the same information as text. -->
      <div
        class="rep-device"
        data-device
        role="img"
        aria-label="An iPhone receiving three calls: one labeled Spam Likely, one from an unknown number, and one from a local business."
      >
        <span class="rep-hw rep-hw-action" aria-hidden="true"></span>
        <span class="rep-hw rep-hw-volup" aria-hidden="true"></span>
        <span class="rep-hw rep-hw-voldn" aria-hidden="true"></span>
        <span class="rep-hw rep-hw-power" aria-hidden="true"></span>

        <div class="rep-screen" aria-hidden="true">
          <div class="rep-wall"></div>

          <div class="rep-status">
            <span class="rep-time">9:41</span>
            <span class="rep-sysicons">
              <Fragment set:html={bars} />
              <Fragment set:html={wifi} />
              <Fragment set:html={batt} />
            </span>
          </div>
          <span class="rep-island"><span class="rep-lens"></span></span>

          <!-- Call UI: swapped per scenario by the script -->
          <div class="rep-ui" data-ui>
            <div class="rep-caller">
              <span class="rep-logo" data-logo>NR</span>
              <span class="rep-name" data-name>Spam Likely</span>
              <span class="rep-sub" data-sub>+1 (628) 555-0114</span>
            </div>

            <div class="rep-ring" data-ring>
              <div class="rep-minor">
                <span class="rep-mbtn"><Fragment set:html={ico.alarm} />Remind Me</span>
                <span class="rep-mbtn"><Fragment set:html={ico.message} />Message</span>
              </div>
              <div class="rep-major">
                <span class="rep-cbtn">
                  <span class="rep-disc rep-disc-decline" data-decline>
                    <Fragment set:html={ico.handset} />
                  </span>
                  Decline
                </span>
                <span class="rep-cbtn">
                  <span class="rep-disc rep-disc-accept" data-accept>
                    <Fragment set:html={ico.handset} />
                  </span>
                  Accept
                </span>
              </div>
            </div>

            <div class="rep-live" data-live>
              <span class="rep-key"><Fragment set:html={ico.speaker} /></span>
              <span class="rep-key"><Fragment set:html={ico.video} /></span>
              <span class="rep-key"><Fragment set:html={ico.mute} /></span>
              <span class="rep-key"><Fragment set:html={ico.more} /></span>
              <span class="rep-key rep-key-end" data-end><Fragment set:html={ico.handset} /></span>
              <span class="rep-key"><Fragment set:html={ico.keypad} /></span>
            </div>
          </div>

          <span class="rep-home"></span>
          <!-- screen-off layer: the phone sleeps between calls -->
          <span class="rep-sleep" data-sleep></span>
        </div>
      </div>
    </div>
</FlankExhibit>

<style>
  /* ---- phone stage ---- */
  .rep-stage {
    display: grid;
    place-items: center;
  }

  /*
   * Device. Every dimension is in em so the whole phone scales from one
   * font-size; 1em = 10px at full size (a 264px-wide phone). Proportions
   * follow a 6.1" iPhone: 71.5 x 147.6 mm body, ~2.3 mm bezel.
   */
  .rep-device {
    --rim: 0.34em;
    --bezel: 0.85em;
    --r-out: 4.5em;
    position: relative;
    isolation: isolate;
    font-size: min(10px, 2.8vw);
    width: 26.4em;
    aspect-ratio: 71.5 / 147.6;
    /* rim + black bezel; the bezel is drawn by the screen's spread shadow */
    padding: calc(var(--rim) + var(--bezel));
    border-radius: var(--r-out);
    /* brushed-titanium rim */
    background: linear-gradient(
      150deg,
      #c3c8cf 0%,
      #6a7079 16%,
      #31363d 45%,
      #4d535b 72%,
      #aab0b8 100%
    );
    box-shadow:
      inset 0 0 0 0.06em rgba(255, 255, 255, 0.35),
      0 3.6em 5.4em -2.4em rgba(15, 23, 42, 0.45),
      0 1.2em 2em -1em rgba(15, 23, 42, 0.3);
  }
  /* Hardware buttons sit behind the rim so only their edge shows. */
  .rep-hw {
    position: absolute;
    z-index: -2;
    width: 0.5em;
    border-radius: 0.25em;
    background: linear-gradient(90deg, #3d424a, #9aa0a8 50%, #3d424a);
  }
  .rep-hw-action { left: -0.42em; top: 9.6em; height: 2.6em; }
  .rep-hw-volup { left: -0.42em; top: 14.2em; height: 4.6em; }
  .rep-hw-voldn { left: -0.42em; top: 19.6em; height: 4.6em; }
  .rep-hw-power { right: -0.42em; top: 15.4em; height: 7.4em; }

  .rep-screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--r-out) - var(--rim) - var(--bezel));
    background: #000;
    box-shadow: 0 0 0 var(--bezel) #050607;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', var(--font-body);
    -webkit-font-smoothing: antialiased;
  }
  /* Glass: a faint diagonal reflection over everything. */
  .rep-screen::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 9;
    pointer-events: none;
    background: linear-gradient(
      118deg,
      rgba(255, 255, 255, 0.09) 0%,
      rgba(255, 255, 255, 0.025) 32%,
      transparent 33%
    );
  }

  /* Blurred, dimmed wallpaper, as iOS shows behind an incoming call. */
  .rep-wall {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(42% 30% at 22% 18%, #4b5fa3, transparent 70%),
      radial-gradient(40% 32% at 88% 42%, #1c6b70, transparent 72%),
      radial-gradient(55% 36% at 30% 88%, #5a3a78, transparent 70%),
      radial-gradient(40% 30% at 80% 92%, #233a6a, transparent 70%),
      #10172a;
    filter: blur(1.6em) saturate(1.1);
  }
  .rep-wall::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(6, 8, 14, 0.42);
  }

  .rep-island {
    position: absolute;
    z-index: 5;
    top: 1.05em;
    left: 50%;
    transform: translateX(-50%);
    width: 7.9em;
    height: 2.3em;
    border-radius: 1.15em;
    background: #000;
  }
  .rep-lens {
    position: absolute;
    right: 0.75em;
    top: 50%;
    width: 0.85em;
    height: 0.85em;
    margin-top: -0.425em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #2b3550, #0b0f1a 60%);
  }
  .rep-status {
    position: absolute;
    z-index: 4;
    top: 1.05em;
    left: 0;
    right: 0;
    height: 2.3em;
    display: grid;
    grid-template-columns: 1fr 7.9em 1fr; /* middle column = island width */
    align-items: center;
    justify-items: center;
    padding: 0 0.6em;
  }
  .rep-sysicons {
    grid-column: 3;
  }
  .rep-time {
    font-size: 1.32em;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .rep-sysicons {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .rep-sysicons :global(svg) {
    height: 1.05em;
    width: auto;
    display: block;
  }
  .rep-sysicons :global(svg:last-child) {
    height: 1.15em;
  }

  .rep-ui {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .rep-caller {
    position: absolute;
    top: 7.6em;
    left: 1.6em;
    right: 1.6em;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .rep-logo {
    display: none;
    font-size: 1.6em;
    width: 3em;
    height: 3em;
    margin-bottom: 0.6em;
    border-radius: 50%;
    place-items: center;
    background: linear-gradient(160deg, #f6f1e7, #e4dccb);
    color: #8a3b12;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.02em;
    box-shadow: 0 0.4em 1.2em rgba(0, 0, 0, 0.35);
  }
  .rep-name {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', var(--font-body);
    font-size: 2.3em;
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .rep-sub {
    margin-top: 0.3em;
    font-size: 1.3em;
    color: rgba(255, 255, 255, 0.62);
    font-variant-numeric: tabular-nums;
  }

  /* Ringing controls */
  .rep-ring {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 3.6em;
    padding: 0 0.4em;
  }
  .rep-minor,
  .rep-major {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .rep-mbtn,
  .rep-cbtn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55em;
    font-size: 1em;
    color: #fff;
  }
  .rep-mbtn {
    font-size: 1.05em;
    gap: 0.45em;
  }
  .rep-mbtn :global(svg) {
    width: 2.1em;
    height: 2.1em;
  }
  .rep-major {
    margin-top: 2.6em;
  }
  .rep-cbtn {
    font-size: 1.15em;
  }
  .rep-disc {
    width: 5.4em;
    height: 5.4em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.87em; /* cancel the label's 1.15em so the disc sizes off 1em */
  }
  .rep-disc :global(svg) {
    width: 2.6em;
    height: 2.6em;
  }
  .rep-disc-decline {
    background: #ff3b30;
  }
  .rep-disc-decline :global(svg) {
    transform: rotate(135deg);
  }
  .rep-disc-accept {
    background: #34c759;
  }

  /* In-call controls (iOS 17 layout, end button in the grid) */
  .rep-live {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5em;
    padding: 0 2.6em;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    justify-items: center;
    row-gap: 1.7em;
    visibility: hidden;
  }
  .rep-key {
    width: 5.6em;
    height: 5.6em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .rep-key :global(svg) {
    width: 2.5em;
    height: 2.5em;
  }
  .rep-key-end {
    background: #ff3b30;
  }
  .rep-key-end :global(svg) {
    transform: rotate(135deg);
  }

  .rep-home {
    position: absolute;
    z-index: 6;
    bottom: 0.8em;
    left: 50%;
    width: 9.6em;
    height: 0.45em;
    margin-left: -4.8em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
  }
  .rep-sleep {
    position: absolute;
    inset: 0;
    z-index: 8;
    background: #000;
    opacity: 0;
    visibility: hidden;
  }

</style>

<script>
  import gsap from 'gsap';
  import { flank } from '../scripts/flank';

  /**
   * Plays three incoming calls the way a real iPhone shows them: the screen
   * wakes, the phone vibrates in buzz/pause bursts, and the call is declined,
   * left to ring out, or answered (in-call screen with a running timer). On
   * wide screens the points that call illustrates light up and their wires
   * draw into the phone. Runs only while on screen; reduced-motion shows a
   * single static frame with every point lit.
   */
  const stage = document.querySelector<HTMLElement>('#compliance [data-call]');

  if (stage) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const el = <T extends Element = HTMLElement>(sel: string) =>
      stage.querySelector<T>(sel)!;

    const device = el('[data-device]');
    const ui = el('[data-ui]');
    const sleep = el('[data-sleep]');
    const ring = el('[data-ring]');
    const live = el('[data-live]');
    const keys = live.children;
    const nameEl = el('[data-name]');
    const subEl = el('[data-sub]');
    const logoEl = el('[data-logo]');
    const declineEl = el('[data-decline]');
    const acceptEl = el('[data-accept]');
    const endEl = el('[data-end]');
    const pts = flank(stage.closest<HTMLElement>('[data-flank]')!);

    type Scene = {
      name: string;
      sub: string;
      brand: boolean;
      action: 'decline' | 'ignore' | 'answer';
      /** indices into rep.points (content.ts) this call illustrates */
      lit: number[];
    };

    // Problem first, then the in-between, then what good looks like.
    const scenes: Scene[] = [
      {
        name: 'Spam Likely',
        sub: '+1 (628) 555-0114',
        brand: false,
        action: 'decline',
        lit: [0], // “Spam Likely” label
      },
      {
        name: '+1 (628) 555-0114',
        sub: 'San Francisco, CA',
        brand: false,
        action: 'ignore',
        lit: [1, 3], // trust grade; rings out to voicemail
      },
      {
        name: 'Northwind Roofing',
        sub: '+1 (512) 555-0143',
        brand: true,
        action: 'answer',
        lit: [2], // business name
      },
    ];

    // Reset the screen to the ringing layout for a scene (phone still asleep).
    const render = (s: Scene) => {
      nameEl.textContent = s.name;
      subEl.textContent = s.sub;
      logoEl.style.display = s.brand ? 'grid' : 'none';
      gsap.set(ring, { autoAlpha: 1, y: 0 });
      gsap.set(live, { autoAlpha: 0 });
      gsap.set(keys, { autoAlpha: 0 });
    };

    // One ringtone vibration burst: a fast low-amplitude buzz, then a pause.
    const buzz = () =>
      gsap
        .timeline()
        .to(device, {
          x: 1.1,
          rotation: 0.35,
          duration: 0.032,
          repeat: 13,
          yoyo: true,
          ease: 'sine.inOut',
        })
        .set(device, { x: 0, rotation: 0 })
        .to({}, { duration: 0.75 });

    // A finger tap: the button dips and brightens, then releases.
    const press = (btn: HTMLElement) =>
      gsap
        .timeline()
        .to(btn, { scale: 0.9, filter: 'brightness(1.3)', duration: 0.1, ease: 'power2.out' })
        .to(btn, { scale: 1, filter: 'brightness(1)', duration: 0.2, ease: 'power2.out' });

    const build = () => {
      const tl = gsap.timeline({ repeat: -1 });

      scenes.forEach((s) => {
        tl.call(render, [s]);
        tl.set(ui, { autoAlpha: 0 });
        tl.set(sleep, { autoAlpha: 1 });
        tl.to({}, { duration: 0.6 });
        tl.call(pts.light, [s.lit]);

        // Screen wakes; the call sheet settles in from slightly enlarged.
        tl.to(sleep, { autoAlpha: 0, duration: 0.3, ease: 'power1.out' });
        tl.fromTo(
          ui,
          { autoAlpha: 0, scale: 1.06 },
          { autoAlpha: 1, scale: 1, duration: 0.5, ease: 'power3.out' },
          '<'
        );

        if (s.action === 'decline') {
          tl.add(buzz()).add(buzz());
          tl.add(press(declineEl));
        } else if (s.action === 'ignore') {
          tl.add(buzz()).add(buzz()).add(buzz()).add(buzz());
        } else {
          tl.add(buzz()).add(buzz());
          tl.add(press(acceptEl));
          tl.call(() => {
            subEl.textContent = '0:00';
          });
          tl.to(ring, { autoAlpha: 0, y: 14, duration: 0.22, ease: 'power2.in' });
          tl.set(live, { autoAlpha: 1 });
          tl.fromTo(
            keys,
            { autoAlpha: 0, scale: 0.86 },
            { autoAlpha: 1, scale: 1, duration: 0.32, stagger: 0.03, ease: 'back.out(1.5)' }
          );
          // Call timer.
          const clock = { t: 0 };
          tl.to(clock, {
            t: 5,
            duration: 5,
            ease: 'none',
            onStart: () => {
              clock.t = 0;
            },
            onUpdate: () => {
              subEl.textContent = `0:${String(Math.floor(clock.t)).padStart(2, '0')}`;
            },
          });
          tl.add(press(endEl));
          tl.call(() => {
            subEl.textContent = 'Call Ended';
          });
          tl.to({}, { duration: 0.8 });
        }

        // Call sheet dismisses and the screen goes back to sleep.
        tl.to(ui, { autoAlpha: 0, scale: 0.97, duration: 0.3, ease: 'power2.in' }, '+=0.15');
        tl.to(sleep, { autoAlpha: 1, duration: 0.35, ease: 'power1.in' }, '-=0.05');
        tl.to({}, { duration: 1.4 });
      });
      return tl;
    };

    if (reduce) {
      // Static, complete frame: the spam call, ringing, every point wired.
      render(scenes[0]);
      pts.all();
    } else {
      render(scenes[0]);
      gsap.set(sleep, { autoAlpha: 1 });
      const tl = build();
      tl.pause();

      // One-time entrance: points slide in from their side toward the phone,
      // then the call loop starts.
      let introduced = false;
      const start = () => {
        if (introduced) return tl.play();
        introduced = true;
        pts.enter(() => tl.play());
      };

      if ('IntersectionObserver' in window) {
        pts.arm();
        const io = new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? start() : tl.pause()),
          { threshold: 0.35 }
        );
        io.observe(device);
      } else {
        tl.play();
      }
    }
  }
</script>
