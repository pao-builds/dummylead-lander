---
/** Compact hero band for inner pages. */
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<section class="page-header">
  <div class="shell">
    <span class="eyebrow" data-reveal>{eyebrow}</span>
    <h1 class="page-title" data-reveal style="--d:0.06s">
      <slot name="title">{title}</slot>
    </h1>
    <p class="page-lede" data-reveal style="--d:0.12s"><slot /></p>
  </div>
</section>

<style>
  .page-header {
    padding: clamp(56px, 8vw, 96px) 0 clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--color-line);
  }
  .page-title {
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    margin: 20px 0 0;
    max-width: 18ch;
  }
  .page-lede {
    margin-top: 22px;
    max-width: 56ch;
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-bone-dim);
  }
  .page-lede:empty {
    display: none;
  }
</style>
